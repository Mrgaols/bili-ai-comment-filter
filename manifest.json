{
  "manifest_version": 3,
  "name": "B站 鱼灾/AI 评论雷达",
  "version": "1.2.0",
  "description": "识别并过滤 Bilibili 评论区的大肥鱼/鲸鲸等 AI 挂机评论，支持概率打标与一键折叠",
  "homepage_url": "https://github.com/Mrgaols/bili-ai-comment-filter",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站 鱼灾/AI 评论设置",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "js": [
        "config.js",
        "detector.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
